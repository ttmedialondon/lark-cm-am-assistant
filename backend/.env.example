DATABASE_URL=postgresql://larkstats:local-dev-only@127.0.0.1:5432/lark_message_stats
LARK_APP_ID=cli_replace_me
LARK_APP_SECRET=
LARK_REDIRECT_URI=https://larkbot.ttapp.help/auth/lark/callback
LARK_OAUTH_SCOPES=offline_access im:chat:read im:message:readonly
TOKEN_ENCRYPTION_KEY_B64=REPLACE_WITH_A_32_BYTE_URLSAFE_BASE64_KEY
SYNC_LOOKBACK_DAYS=0
SYNC_INTERVAL_SECONDS=300
SYNC_OVERLAP_SECONDS=600
MEMBER_COUNT_REFRESH_SECONDS=86400
MAX_PAGES_PER_JOB=30
