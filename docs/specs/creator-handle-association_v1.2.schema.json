{
  "type": "object",
  "description": "达人—handle 关联协议 v1.10（creator-handle-research-v1.10）；输出字段不变。聊天含义由模型判断，服务端只校验协议、引用、精确账号、真实回复关系、有效授权和实际数据冲突，不以关键词复判语义。",
  "additionalProperties": false,
  "properties": {
    "creator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {"type": "string", "enum": ["known", "supported", "review", "not_supported"]},
        "refs": {"type": "array", "items": {"type": "string"}, "maxItems": 6}
      },
      "required": ["state", "refs"]
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "h": {"type": "string"},
          "decision": {"type": "string", "enum": ["supported", "review", "not_supported"]},
          "relation": {"type": "string", "enum": ["self_account", "account_creator", "operator", "other_person", "mention_only", "uncertain"]},
          "period": {"type": "string", "enum": ["at_message", "historical", "unknown"]},
          "code": {"type": "string", "enum": ["self_claim", "qa_confirm", "own_page", "group_context", "own_content", "operates_for_other", "third_party", "mention_only", "no_link_evidence", "ambiguous_reply", "conflict", "username_changed", "out_of_catalog"]},
          "refs": {"type": "array", "items": {"type": "string"}, "maxItems": 6},
          "needed": {"type": "array", "items": {"type": "string", "enum": ["parent_reply", "identity_context", "account_context", "earlier_username", "other_claimants", "recent_state"]}}
        },
        "required": ["h", "decision", "relation", "period", "code", "refs", "needed"]
      }
    }
  },
  "required": ["creator", "links"]
}
