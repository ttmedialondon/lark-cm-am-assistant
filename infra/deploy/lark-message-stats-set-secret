#!/usr/bin/env bash
# Run as root on the Hetzner server. It never prints the App Secret.
set -euo pipefail

env_file=/etc/lark-message-stats/app.env
if [[ ${EUID} -ne 0 ]]; then
  echo "Run this command as root or via sudo." >&2
  exit 1
fi
if [[ ! -f "$env_file" ]]; then
  echo "Configuration file not found: $env_file" >&2
  exit 1
fi

read -r -s -p "Paste Lark App Secret (input will stay hidden): " app_secret
printf '\n'
if [[ -z "$app_secret" || "$app_secret" == *$'\n'* || "$app_secret" == *$'\r'* ]]; then
  echo "Secret cannot be empty or contain a line break." >&2
  exit 1
fi

tmp_file=$(mktemp /etc/lark-message-stats/.app.env.XXXXXX)
trap 'rm -f "$tmp_file"' EXIT
grep -v '^LARK_APP_SECRET=' "$env_file" > "$tmp_file" || true
printf 'LARK_APP_SECRET=%s\n' "$app_secret" >> "$tmp_file"
chown root:larkstats "$tmp_file"
chmod 0640 "$tmp_file"
mv "$tmp_file" "$env_file"
trap - EXIT
unset app_secret

systemctl restart lark-message-stats-web.service lark-message-stats-worker.service
systemctl is-active --quiet lark-message-stats-web.service
systemctl is-active --quiet lark-message-stats-worker.service
echo "App Secret stored with restricted permissions; Web and worker have restarted."
